ARG BUILD_BASE
FROM ${BUILD_BASE} AS build

ARG RELEASE
WORKDIR /src
RUN apk add --no-cache ca-certificates git
COPY . .
ENV CGO_ENABLED=0
RUN go build -trimpath -ldflags "-s -w -X github.com/minio/minio/cmd.ReleaseTag=${RELEASE}" -o /out/minio .

ARG RUNTIME_BASE
FROM ${RUNTIME_BASE}
ARG RELEASE
LABEL org.opencontainers.image.title="MinIO" \
      org.opencontainers.image.version="${RELEASE}" \
      org.opencontainers.image.source="https://github.com/Beaker12/minio"
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
COPY --from=build /out/minio /usr/bin/minio
COPY CREDITS /licenses/CREDITS
COPY LICENSE /licenses/LICENSE
COPY dockerscripts/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh
RUN chmod 0755 /usr/bin/minio /usr/bin/docker-entrypoint.sh
EXPOSE 9000 9001
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio"]
